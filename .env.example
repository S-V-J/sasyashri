# Sasyashri Environment Configuration
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://sasyashri:secure_password@localhost:5432/sasyashri?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 48
JWT_SECRET="your_64_character_jwt_secret_here_minimum_64_chars"
JWT_REFRESH_SECRET="your_64_character_refresh_secret_here_minimum_64_chars"

# WebAuthn (Passkeys) - Production must use real domain
WEB_AUTHN_RP_ID="localhost"
WEB_AUTHN_ORIGIN="https://localhost:3000"
WEB_AUTHN_RP_NAME="Sasyashri"

# ============================================
# NVIDIA AI (Riva/NIM) - Provided by Founder
# ============================================
NVIDIA_RIVA_API_KEY="your_nvidia_riva_api_key"
NVIDIA_RIVA_ENDPOINT="grpc://localhost:50051"  # Or cloud endpoint
NVIDIA_NIM_ENDPOINT="https://integrate.api.nvidia.com/v1"

# ============================================
# LIVEKIT (WebRTC)
# ============================================
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret_min_32_chars"
LIVEKIT_WS_URL="wss://localhost:7880"

# ============================================
# PAYMENTS (RazorpayX / Cashfree)
# ============================================
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Cashfree (Alternative)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# ============================================
# GST/GSP INTEGRATION (MasterGST / ClearTax Sandbox)
# ============================================
GSP_CLIENT_ID="your_gsp_client_id"
GSP_CLIENT_SECRET="your_gsp_client_secret"
GSP_API_URL="https://api-sandbox.mastergst.com"

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Sasyashri <noreply@sasyashri.duckdns.org>"

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# MINIO (Object Storage)
# ============================================
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin123"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="sasyashri"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://localhost:3000"
NEXT_PUBLIC_API_URL="https://localhost:4000"
NEXT_PUBLIC_LIVEKIT_WS_URL="wss://localhost:7880"

# ============================================
# DUCKDNS (Production)
# ============================================
DUCKDNS_DOMAIN="sasyashri.duckdns.org"
DUCKDNS_TOKEN="your_duckdns_token"

# ============================================
# MONITORING
# ============================================
GRAFANA_PASSWORD="admin123"
PROMETHEUS_RETENTION="30d"

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_PWA=true
ENABLE_WEB_AUTHN=true
ENABLE_AI_VOICE=true
ENABLE_OCR=true
ENABLE_GST_FILING=false
ENABLE_PAYMENTS_SANDBOX=true