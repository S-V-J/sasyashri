{
  "name": "@sasyashri/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter=@sasyashri/database db:generate",
    "db:migrate:dev": "pnpm --filter=@sasyashri/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter=@sasyashri/database db:migrate:deploy",
    "db:seed": "pnpm --filter=@sasyashri/database db:seed",
    "db:studio": "pnpm --filter=@sasyashri/database db:studio",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next-intl": "^3.10.0",
