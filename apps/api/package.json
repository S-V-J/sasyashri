{
  "name": "@sasyashri/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "pnpm --filter=@sasyashri/database db:generate",
    "db:migrate:dev": "pnpm --filter=@sasyashri/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter=@sasyashri/database db:migrate:deploy",
    "db:seed": "pnpm --filter=@sasyashri/database db:seed",
    "db:studio": "pnpm --filter=@sasyashri/database db:studio",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/bullmq": "^10.0.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4",
    "ioredis": "^5.3.2",
    "bullmq": "^5.7.0",
    "axios": "^1.6.7",
    "razorpay": "^2.9.2",
    "cashfree-pg": "^2.0.0",
    "@simplewebauthn/server": "^9.0.0",
    "livekit-server-sdk": "^2.0.0",
    "nvidia-riva-client": "^2.0.0",
    "tesseract.js": "^5.0.0",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.2",
    "zod": "^3.22.4",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^2.0.0",
    "uuid": "^9.0.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "csurf": "^1.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/csurf": "^1.11.5",
    "@types/uuid": "^9.0.8",
    "@types/jest": "^29.5.12",
    "typescript": "^5.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.2.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.0"
  }
}